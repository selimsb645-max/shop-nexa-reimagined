rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isApprovedSeller() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/sellers/$(request.auth.uid))
        && get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.status == 'approved';
    }
    // True when the caller is the seller assigned to this order (buyer-side copy).
    function isOrderSeller() {
      return isApprovedSeller()
        && 'sellerIds' in resource.data
        && request.auth.uid in resource.data.sellerIds;
    }
    // Restrict an update to only touch an allow-listed set of fields.
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Categories - admin managed
    match /categories/{cat} {
      allow read: if true;
      allow write: if isAdmin();
      match /subcategories/{sub} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /products/{id} {
      allow read: if true;
      allow create: if isAdmin() ||
        (isApprovedSeller() && request.resource.data.sellerId == request.auth.uid);
      allow delete: if isAdmin() ||
        (isApprovedSeller() && resource.data.sellerId == request.auth.uid);
      // Only the owning seller or an admin may modify a product. Stock changes
      // caused by a purchase are applied by the trusted server-side checkout
      // (service account), never by a buyer's browser.
      allow update: if isAdmin()
        || (isApprovedSeller() && resource.data.sellerId == request.auth.uid);

      match /reviews/{rid} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    match /coupons/{code} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Only admins may edit coupons. The `uses` counter is incremented by the
      // trusted server-side checkout, so clients can no longer burn through a
      // coupon's usage limit without a real order.
      allow update: if isAdmin();
    }


    // Banners - public read, admin write
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings - public read, admin write
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Activity logs - admin only
    match /activityLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Users - role & blocked flag can only be changed by admins
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && (!('role' in request.resource.data) || request.resource.data.role == 'customer')
        && (!('blocked' in request.resource.data) || request.resource.data.blocked == false);
      allow update: if isAdmin() ||
        (isSelf(uid)
          && request.resource.data.role == resource.data.role
          && (!('blocked' in request.resource.data) ? true : request.resource.data.blocked == resource.data.blocked));
      allow delete: if isAdmin();

      // Cart and wishlist - owner-editable
      match /cart/{itemId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }
      match /wishlist/{itemId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }

      // Orders - buyer can read; buyer may create (once, via checkout) with a
      // structurally + arithmetically consistent payload; buyers can NEVER
      // update or delete an order after creation. Only the assigned seller
      // (status/tracking only) or an admin (any field) may update it.
      match /orders/{orderId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.payment.status in ['pending', 'unpaid']
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.subtotal is number && request.resource.data.subtotal >= 0
          && request.resource.data.discount is number
          && request.resource.data.discount >= 0
          && request.resource.data.discount <= request.resource.data.subtotal
          && request.resource.data.shipping is number && request.resource.data.shipping >= 0
          // total must equal subtotal - discount + shipping (small float tolerance)
          && request.resource.data.total is number
          && request.resource.data.total - (request.resource.data.subtotal - request.resource.data.discount + request.resource.data.shipping) <= 0.01
          && (request.resource.data.subtotal - request.resource.data.discount + request.resource.data.shipping) - request.resource.data.total <= 0.01;
        allow update: if isAdmin()
          || (isOrderSeller() && onlyChanges(['status', 'tracking', 'updatedAt']));
        allow delete: if isAdmin();
      }

      // Wallet ledger - server-controlled only. Clients (including the owner)
      // may never write cashback/refund/topup/spend entries directly; only a
      // trusted admin/server context can. Owners may only read their own.
      match /walletTx/{txId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isAdmin();
      }

      // Reward points ledger - server-controlled only, same reasoning as wallet.
      match /rewardTx/{txId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isAdmin();
      }

      // Referral records - server-controlled only (bonusPoints is a balance-
      // affecting field, so referral crediting must not be client-writable).
      match /referrals/{refId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isAdmin();
      }

      // Any other user-owned subcollection remains owner-scoped
      match /{sub}/{docId} {
        allow read, write: if (isSelf(uid) || isAdmin())
          && !(sub in ['orders', 'walletTx', 'rewardTx', 'referrals']);
      }
    }

    // Sellers
    match /sellers/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && request.resource.data.status == 'pending';
      allow update: if (isSelf(uid) && request.resource.data.status == resource.data.status) || isAdmin();
      allow delete: if isAdmin();

      match /orders/{orderId} {
        allow read: if isSelf(uid) || isAdmin();
        // Only the buyer can create the seller mirror, and only with matching sellerId/buyerId + safe initial state
        allow create: if isSignedIn()
          && request.resource.data.sellerId == uid
          && request.resource.data.buyerId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.paymentStatus in ['pending', 'unpaid'];
        // Seller may only progress status/tracking on their own mirror; admin can do anything.
        allow update: if isAdmin()
          || (isSelf(uid) && onlyChanges(['status', 'tracking', 'updatedAt']));
        allow delete: if isAdmin();
      }
      match /notifications/{nid} {
        allow read: if isSelf(uid) || isAdmin();
        // Buyers may create notifications only tied to their own order action; seller/admin can create freely
        allow create: if isAdmin() || isSelf(uid) ||
          (isSignedIn()
            && request.resource.data.read == false
            && request.resource.data.type == 'order');
        allow update, delete: if isSelf(uid) || isAdmin();
      }
    }
  }
}
