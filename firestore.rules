rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isApprovedSeller() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/sellers/$(request.auth.uid))
        && get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.status == 'approved';
    }
    // True when the caller is the seller assigned to this order (buyer-side copy).
    function isOrderSeller() {
      return isApprovedSeller()
        && 'sellerIds' in resource.data
        && request.auth.uid in resource.data.sellerIds;
    }
    // Restrict an update to only touch an allow-listed set of fields.
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Categories - admin managed
    match /categories/{cat} {
      allow read: if true;
      allow write: if isAdmin();
      match /subcategories/{sub} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /products/{id} {
      allow read: if true;
      allow create: if isAdmin() ||
        (isApprovedSeller()
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.approved == false
          && (!('featured' in request.resource.data) || request.resource.data.featured == false));
      allow delete: if isAdmin() ||
        (isApprovedSeller() && resource.data.sellerId == request.auth.uid);
      allow update: if isAdmin()
        || (isApprovedSeller()
          && resource.data.sellerId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['approved', 'featured', 'rating', 'reviewCount', 'sellerId']));

      match /reviews/{rid} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    match /coupons/{code} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // Promo Codes - server-side generated only.
    // Users can READ only their own promo codes (where userId == auth.uid).
    // ALL client writes are blocked — generation, mutation, and status
    // changes happen exclusively through trusted server functions
    // (service account bypasses these rules).
    // Admins can read all promo codes but cannot write from client either.
    match /promoCodes/{code} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create, update, delete: if false;
    }

    // Banners - public read, admin write
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings - public read, admin write
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Activity logs - admin only
    match /activityLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Users - role & blocked flag can only be changed by admins
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && (!('role' in request.resource.data) || request.resource.data.role == 'customer')
        && (!('blocked' in request.resource.data) || request.resource.data.blocked == false);
      allow update: if isAdmin() ||
        (isSelf(uid)
          && request.resource.data.role == resource.data.role
          && (!('blocked' in request.resource.data) ? true : request.resource.data.blocked == resource.data.blocked));
      allow delete: if isAdmin();

      // Cart and wishlist - owner-editable
      match /cart/{itemId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }
      match /wishlist/{itemId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }

      // Orders - buyer can read only. Orders are written exclusively by the
      // trusted server-side checkout (service account, which bypasses these
      // rules) after it recomputes every price, discount, shipping and total
      // from the real product documents. No client may create, update or
      // delete an order. Only the assigned seller (status/tracking) or an
      // admin may progress an existing order.
      match /orders/{orderId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if false;
        allow update: if isAdmin()
          || (isOrderSeller() && onlyChanges(['status', 'tracking', 'updatedAt']));
        allow delete: if isAdmin();
      }

      // Wallet ledger - server-controlled only. Clients (including the owner)
      // may never write cashback/refund/topup/spend entries directly; only a
      // trusted admin/server context can. Owners may only read their own.
      match /walletTx/{txId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isAdmin();
      }

      // Reward points ledger - server-controlled only, same reasoning as wallet.
      match /rewardTx/{txId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isAdmin();
      }

      // Referral records - server-controlled only
      match /referrals/{refId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isAdmin();
      }

      // Any other user-owned subcollection remains owner-scoped
      match /{sub}/{docId} {
        allow read, write: if (isSelf(uid) || isAdmin())
          && !(sub in ['orders', 'walletTx', 'rewardTx', 'referrals']);
      }
    }

    // Sellers
    match /sellers/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && request.resource.data.status == 'draft';
      allow update: if isAdmin()
        || (isSelf(uid)
          && (
            request.resource.data.status == resource.data.status
            || (resource.data.status == 'draft' && request.resource.data.status == 'pending_review')
            || (resource.data.status == 'need_documents' && request.resource.data.status == 'pending_review')
          ));
      allow delete: if isAdmin();

      // Seller orders - created by server-side checkout only.
      // Sellers may update ONLY status/tracking/updatedAt.
      // Settlement fields are protected — sellers CANNOT modify:
      //   settlement, earnings, commission, commissionRate, discountShare,
      //   shippingShare, netSubtotal, subtotal, paymentStatus, paymentMethod
      match /orders/{orderId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if false;
        allow update: if isAdmin()
          || (isSelf(uid)
            && onlyChanges(['status', 'tracking', 'updatedAt'])
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['settlement', 'earnings', 'commission', 'commissionRate',
                          'discountShare', 'shippingShare', 'netSubtotal',
                          'subtotal', 'paymentStatus', 'paymentMethod']));
        allow delete: if isAdmin();
      }

      // Settlement ledger — immutable, server-side only.
      // Sellers can READ their own ledger but can NEVER create/update/delete.
      match /settlementTx/{txId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update, delete: if false;
      }

      // Wallet ledger (seller) — server-controlled only.
      match /walletTx/{txId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update, delete: if false;
      }

      // Withdrawals — created/updated by server functions only.
      // Sellers can READ their own withdrawals but cannot mutate.
      match /withdrawals/{withdrawalId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update, delete: if false;
      }

      // Notifications
      match /notifications/{nid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || isSelf(uid);
        allow update, delete: if isSelf(uid) || isAdmin();
      }
    }
  }
}
