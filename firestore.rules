rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isApprovedSeller() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/sellers/$(request.auth.uid))
        && get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.status == 'approved';
    }
    // True when the caller is the seller assigned to this order (buyer-side copy).
    function isOrderSeller() {
      return isApprovedSeller()
        && 'sellerIds' in resource.data
        && request.auth.uid in resource.data.sellerIds;
    }
    // Restrict an update to only touch an allow-listed set of fields.
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Categories - admin managed
    match /categories/{cat} {
      allow read: if true;
      allow write: if isAdmin();
      match /subcategories/{sub} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /products/{id} {
      allow read: if true;
      // Moderation/curation fields are admin-only. Sellers must submit products
      // unapproved and unfeatured, and may never flip those fields later.
      allow create: if isAdmin() ||
        (isApprovedSeller()
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.approved == false
          && (!('featured' in request.resource.data) || request.resource.data.featured == false));
      allow delete: if isAdmin() ||
        (isApprovedSeller() && resource.data.sellerId == request.auth.uid);
      // Only the owning seller or an admin may modify a product. Stock changes
      // caused by a purchase are applied by the trusted server-side checkout
      // (service account), never by a buyer's browser. Sellers may not touch
      // moderation, curation or aggregate rating fields.
      allow update: if isAdmin()
        || (isApprovedSeller()
          && resource.data.sellerId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['approved', 'featured', 'rating', 'reviewCount', 'sellerId']));

      match /reviews/{rid} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    match /coupons/{code} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Only admins may edit coupons. The `uses` counter is incremented by the
      // trusted server-side checkout, so clients can no longer burn through a
      // coupon's usage limit without a real order.
      allow update: if isAdmin();
    }


    // Banners - public read, admin write
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings - public read, admin write
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Activity logs - admin only
    match /activityLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Users - role & blocked flag can only be changed by admins
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && (!('role' in request.resource.data) || request.resource.data.role == 'customer')
        && (!('blocked' in request.resource.data) || request.resource.data.blocked == false);
      allow update: if isAdmin() ||
        (isSelf(uid)
          && request.resource.data.role == resource.data.role
          && (!('blocked' in request.resource.data) ? true : request.resource.data.blocked == resource.data.blocked));
      allow delete: if isAdmin();

      // Cart and wishlist - owner-editable
      match /cart/{itemId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }
      match /wishlist/{itemId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }

      // Orders - buyer can read only. Orders are written exclusively by the
      // trusted server-side checkout (service account, which bypasses these
      // rules) after it recomputes every price, discount, shipping and total
      // from the real product documents. No client may create, update or
      // delete an order. Only the assigned seller (status/tracking) or an
      // admin may progress an existing order.
      match /orders/{orderId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if false;
        allow update: if isAdmin()
          || (isOrderSeller() && onlyChanges(['status', 'tracking', 'updatedAt']));
        allow delete: if isAdmin();
      }


      // Wallet ledger - server-controlled only. Clients (including the owner)
      // may never write cashback/refund/topup/spend entries directly; only a
      // trusted admin/server context can. Owners may only read their own.
      match /walletTx/{txId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isAdmin();
      }

      // Reward points ledger - server-controlled only, same reasoning as wallet.
      match /rewardTx/{txId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isAdmin();
      }

      // Referral records - server-controlled only (bonusPoints is a balance-
      // affecting field, so referral crediting must not be client-writable).
      match /referrals/{refId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isAdmin();
      }

      // Any other user-owned subcollection remains owner-scoped
      match /{sub}/{docId} {
        allow read, write: if (isSelf(uid) || isAdmin())
          && !(sub in ['orders', 'walletTx', 'rewardTx', 'referrals']);
      }
    }

    // Sellers
    match /sellers/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && request.resource.data.status == 'pending';
      allow update: if (isSelf(uid) && request.resource.data.status == resource.data.status) || isAdmin();
      allow delete: if isAdmin();

      match /orders/{orderId} {
        allow read: if isSelf(uid) || isAdmin();
        // The seller's copy of an order is written only by the trusted
        // server-side checkout, so a buyer can no longer forge a seller order.
        allow create: if false;
        // Seller may only progress status/tracking on their own mirror; admin can do anything.
        allow update: if isAdmin()
          || (isSelf(uid) && onlyChanges(['status', 'tracking', 'updatedAt']));
        allow delete: if isAdmin();
      }
      match /notifications/{nid} {
        allow read: if isSelf(uid) || isAdmin();
        // Order notifications come from the trusted server-side checkout.
        // Only the seller themselves or an admin may create others.
        allow create: if isAdmin() || isSelf(uid);
        allow update, delete: if isSelf(uid) || isAdmin();
      }

    }
  }
}
