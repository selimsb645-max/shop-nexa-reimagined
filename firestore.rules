rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isApprovedSeller() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/sellers/$(request.auth.uid))
        && get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.status == 'approved';
    }

    // Categories - admin managed
    match /categories/{cat} {
      allow read: if true;
      allow write: if isAdmin();
      match /subcategories/{sub} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /products/{id} {
      allow read: if true;
      allow create: if isAdmin() ||
        (isApprovedSeller() && request.resource.data.sellerId == request.auth.uid);
      allow delete: if isAdmin() ||
        (isApprovedSeller() && resource.data.sellerId == request.auth.uid);
      // Owning seller or admin can update freely; any signed-in buyer may ONLY
      // decrement stock (and touch updatedAt) as part of placing an order.
      allow update: if isAdmin()
        || (isApprovedSeller() && resource.data.sellerId == request.auth.uid)
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0
          && request.resource.data.stock < resource.data.stock
        );

      match /reviews/{rid} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    match /coupons/{code} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Admin can edit anything; any signed-in user may only increment `uses` by 1 at checkout.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
          && request.resource.data.uses == resource.data.uses + 1
        );
    }

    // Banners - public read, admin write
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings - public read, admin write
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Activity logs - admin only
    match /activityLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Users - role & blocked flag can only be changed by admins
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && (!('role' in request.resource.data) || request.resource.data.role == 'customer')
        && (!('blocked' in request.resource.data) || request.resource.data.blocked == false);
      allow update: if isAdmin() ||
        (isSelf(uid)
          && request.resource.data.role == resource.data.role
          && (!('blocked' in request.resource.data) ? true : request.resource.data.blocked == resource.data.blocked));
      allow delete: if isAdmin();

      // Cart and wishlist - owner-editable
      match /cart/{itemId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }
      match /wishlist/{itemId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }

      // Orders - buyer can read; creation only via trusted checkout (buyer creating own order with valid initial state); updates/deletes admin-only
      match /orders/{orderId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.payment.status in ['pending', 'unpaid'];
        allow update, delete: if isAdmin();
      }

      // Any other user-owned subcollection remains owner-scoped
      match /{sub}/{docId} {
        allow read, write: if (isSelf(uid) || isAdmin())
          && !(sub in ['orders']);
      }
    }

    // Sellers
    match /sellers/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && request.resource.data.status == 'pending';
      allow update: if (isSelf(uid) && request.resource.data.status == resource.data.status) || isAdmin();
      allow delete: if isAdmin();

      match /orders/{orderId} {
        allow read: if isSelf(uid) || isAdmin();
        // Only the buyer can create the seller mirror, and only with matching sellerId/buyerId + safe initial state
        allow create: if isSignedIn()
          && request.resource.data.sellerId == uid
          && request.resource.data.buyerId == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.paymentStatus in ['pending', 'unpaid'];
        allow update: if isSelf(uid) || isAdmin();
        allow delete: if isAdmin();
      }
      match /notifications/{nid} {
        allow read: if isSelf(uid) || isAdmin();
        // Buyers may create notifications only tied to their own order action; seller/admin can create freely
        allow create: if isAdmin() || isSelf(uid) ||
          (isSignedIn()
            && request.resource.data.read == false
            && request.resource.data.type == 'order');
        allow update, delete: if isSelf(uid) || isAdmin();
      }
    }
  }
}
