rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isApprovedSeller() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/sellers/$(request.auth.uid))
        && get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data.status == 'approved';
    }

    function isOrderSeller() {
      return isApprovedSeller()
        && 'sellerIds' in resource.data
        && request.auth.uid in resource.data.sellerIds;
    }

    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // PUBLIC MASTER DATA

    match /locations/{locId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{cat} {
      allow read: if true;
      allow write: if isAdmin();
      match /subcategories/{sub} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }


    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PRODUCTS

    match /products/{id} {
      allow read: if true;
      allow create: if isAdmin() ||
        (isApprovedSeller()
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.approved == false
          && (!('featured' in request.resource.data) || request.resource.data.featured == false));
      allow delete: if isAdmin() ||
        (isApprovedSeller() && resource.data.sellerId == request.auth.uid);
      allow update: if isAdmin()
        || (isApprovedSeller()
          && resource.data.sellerId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['approved', 'featured', 'rating', 'reviewCount', 'sellerId']));

      match /reviews/{rid} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    match /coupons/{code} {
      allow read: if true;
      allow create: if isAdmin()
        || (isApprovedSeller()
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.uses == 0);
      allow update: if isAdmin()
        || (isApprovedSeller()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt']));
      allow delete: if isAdmin()
        || (isApprovedSeller() && resource.data.sellerId == request.auth.uid);
    }

    match /promoCodes/{code} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create, update, delete: if false;
    }

    match /activityLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // USERS

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && (!('role' in request.resource.data) || request.resource.data.role == 'customer')
        && (!('blocked' in request.resource.data) || request.resource.data.blocked == false);
      allow update: if isAdmin() ||
        (isSelf(uid)
          && request.resource.data.role == resource.data.role
          && (!('blocked' in request.resource.data) ? true : request.resource.data.blocked == resource.data.blocked));
      allow delete: if isAdmin();

      match /cart/{itemId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }

      match /wishlist/{itemId} {
        allow read, write: if isSelf(uid) || isAdmin();
      }

      // Verification sessions - server-created only, client read-only
      match /verificationSessions/{sessionId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      // Notification logs - server-created, read-only for owner
      match /notificationLogs/{logId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if false;
      }

      // Email delivery logs - server-created only, no client access
      match /emailLogs/{logId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // Orders - buyer read, seller update fulfillment only, no client create
      match /orders/{orderId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if false;
        allow update: if isAdmin()
          || (isOrderSeller()
            && onlyChanges(['status', 'tracking', 'courierInfo', 'updatedAt']));
        allow delete: if isAdmin();
      }

      match /walletTx/{txId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /rewardTx/{txId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /referrals/{refId} {
        allow read: if isSelf(uid) || isAdmin();
        allow write: if isAdmin();
      }

      match /addresses/{addressId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid);
        allow update: if isSelf(uid) || isAdmin();
        allow delete: if isSelf(uid) || isAdmin();
      }

      match /prefs/{docId} {
        allow read: if isSelf(uid);
        allow write: if isSelf(uid);
      }

      match /sessions/{sessionId} {
        allow read, delete: if isSelf(uid);
        allow create: if isSelf(uid);
        allow update: if isSelf(uid);
      }

      // AI request logs - server-created only, no client access
      match /aiRequests/{reqId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // Catch-all - CRITICAL: verificationSessions and notificationLogs
      // excluded to prevent bypassing their allow:if false rules
      match /{sub}/{docId} {
        allow read, write: if (isSelf(uid) || isAdmin())
          && !(sub in ['orders', 'walletTx', 'rewardTx', 'referrals',
                       'prefs', 'sessions', 'verificationSessions',
                       'notificationLogs', 'emailLogs', 'aiRequests']);
      }
    }

    // CONVERSATIONS — shared collection for customer-seller messaging
    // Both participants (customer and seller) can read/write their own conversations
    match /conversations/{convId} {
      allow read: if isSignedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
          || isAdmin()
        );
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid
        && 'sellerId' in request.resource.data
        && 'customerId' in request.resource.data
        && 'lastMessage' in request.resource.data;
      allow update: if isSignedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
          || isAdmin()
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastAt', 'customerUnread', 'sellerUnread'
        ]);
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isSignedIn()
          && (
            get(/databases/$(database)/documents/conversations/$(convId)).data.customerId == request.auth.uid
            || get(/databases/$(database)/documents/conversations/$(convId)).data.sellerId == request.auth.uid
            || isAdmin()
          );
        allow create: if isSignedIn()
          && request.resource.data.from in ['customer', 'seller']
          && request.resource.data.senderId == request.auth.uid
          && (
            get(/databases/$(database)/documents/conversations/$(convId)).data.customerId == request.auth.uid
            || get(/databases/$(database)/documents/conversations/$(convId)).data.sellerId == request.auth.uid
          );
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // SELLERS

    match /sellers/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && request.resource.data.status == 'draft';
      allow update: if isAdmin()
        || (isSelf(uid)
          && (
            request.resource.data.status == resource.data.status
            || (resource.data.status == 'draft' && request.resource.data.status == 'pending_review')
            || (resource.data.status == 'need_documents' && request.resource.data.status == 'pending_review')
          )
          // SECURITY: Seller self-updates can ONLY touch seller-editable fields.
          // System-controlled financial/status fields are protected.
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'shopName', 'shopSlug', 'description', 'logoUrl', 'bannerUrl',
            'phone', 'addressLine', 'city', 'area', 'country', 'postalCode',
            'business', 'identity', 'bankInfo',
            'currentStep', 'updatedAt',
            'termsAccepted', 'termsAcceptedAt',
            'submittedAt',
            'status'
          ])
          // Even within allowed fields, financial fields are NEVER writable by seller
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'commissionRate', 'totalEarnings', 'availableBalance',
            'pendingBalance', 'withdrawnTotal', 'verified',
            'totalProducts', 'totalOrders', 'rating', 'ratingCount',
            'followers', 'approvedAt', 'rejectionReason',
            'email', 'uid', 'createdAt',
            'storeSettings', 'warehouses', 'pickupPoints',
            'supportedCurrencies', 'internationalShipping', 'crossBorderSeller'
          ]));
      allow delete: if isAdmin();

      // Seller orders - server-created, seller updates fulfillment only
      // shipping allowed but shippingCharge protected within it
      match /orders/{orderId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if false;
        allow update: if isAdmin()
          || (isSelf(uid)
            && onlyChanges(['status', 'tracking', 'shipping', 'updatedAt'])
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['settlement', 'earnings', 'commission', 'commissionRate',
                          'discountShare', 'shippingShare', 'netSubtotal',
                          'subtotal', 'paymentStatus', 'paymentMethod'])
            && (!('shipping' in request.resource.data.diff(resource.data).affectedKeys())
                || (resource.data.shipping.shippingCharge
                    == request.resource.data.shipping.shippingCharge)));
        allow delete: if isAdmin();
      }

      match /settlementTx/{txId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update, delete: if false;
      }

      match /walletTx/{txId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update, delete: if false;
      }

      match /withdrawals/{withdrawalId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update, delete: if false;
      }

      match /notifications/{nid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isAdmin() || isSelf(uid);
        allow update, delete: if isSelf(uid) || isAdmin();
      }
    }
  }
}
