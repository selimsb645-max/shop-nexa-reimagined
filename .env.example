# ═══════════════════════════════════════════════════════════════
# Shop Nexa Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env (development) or set as server secrets (production).
# NEVER commit real secrets to git. .env and .dev.vars are gitignored.

# ─── AI ASSISTANT ───────────────────────────────────────────────
# Provider selection: "local" | "openai" | "mock"
AI_PROVIDER="local"

# Local inference (Ollama, llama.cpp, vLLM, etc.)
# Any OpenAI-compatible endpoint works.
AI_LOCAL_BASE_URL="http://localhost:11434/v1"
AI_LOCAL_MODEL=""  # e.g. "llama3", "qwen2.5" — required when AI_PROVIDER=local

# Fallback behavior on provider failure:
#   "none" → user gets an honest error message (production default)
#   "mock" → development fallback to deterministic responses
AI_FALLBACK_PROVIDER="none"

# OpenAI (optional — only needed when AI_PROVIDER=openai)
AI_API_KEY=""
AI_API_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Shared AI config
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=15000
AI_RATE_LIMIT_PER_HOUR=20
AI_MAX_HISTORY=10

# ─── FIREBASE ───────────────────────────────────────────────────
# (Add your Firebase config here — see existing .env)

# ─── IMAGEKIT (Image Storage + Optimization) ─────────────────────
# Client-safe public config (VITE_ vars are exposed to the browser).
# URL endpoint from the ImageKit dashboard.
VITE_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/a54npygmh"

# Public API key (starts with public_) — safe to ship client-side.
VITE_IMAGEKIT_PUBLIC_KEY=""

# SERVER ONLY — signs upload requests. NEVER expose to the client.
# Found in ImageKit dashboard → Developer options → API keys.
IMAGEKIT_PRIVATE_KEY=""

# ─── EMAIL (Transactional, server-side only — never commit real secrets) ──
# Provider: "mock" (dev), "gmail" (Gmail SMTP, free), "resend", "sendgrid"
EMAIL_PROVIDER=""
# Gmail SMTP app passwords (Google Account → Security → 2FA → App passwords),
# one per department mailbox. Server-side only.
GMAIL_ORDERS_APP_PASSWORD=""
GMAIL_SUPPORT_APP_PASSWORD=""
GMAIL_INFO_APP_PASSWORD=""
GMAIL_NOREPLY_APP_PASSWORD=""
# Optional: Resend / SendGrid API keys + custom-domain From override
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_FROM=""\n
# ─── ORDER VERIFICATION OTP DELIVERY ───────────────────────────
# Provider for checkout verification codes: mock | sms | whatsapp | whatsapp_test
# - mock: dev/test only (code shown in UI, NOT sent) — BLOCKED in production
# - whatsapp_test: FREE CallMeBot WhatsApp delivery to one registered test
#   number (current test setup). Later, switch to "sms" for real customers.
VERIFICATION_PROVIDER="whatsapp_test"

# CallMeBot test WhatsApp (one-time: message "I allow callmebot to send me
# messages" to the CallMeBot bot from that WhatsApp to receive the API key)
CALLMEBOT_PHONE=""
CALLMEBOT_APIKEY=""

# Future real gateways (unused for now)
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""
SMS_GATEWAY_DEVICE_ID=""
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
