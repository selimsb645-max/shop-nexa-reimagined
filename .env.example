# ═══════════════════════════════════════════════════════════════
# Shop Nexa Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env (development) or set as server secrets (production).
# NEVER commit real secrets to git. .env and .dev.vars are gitignored.

# ─── AI ASSISTANT ───────────────────────────────────────────────
# Provider selection: "local" | "openai" | "mock"
AI_PROVIDER="local"

# Local inference (Ollama, llama.cpp, vLLM, etc.)
# Any OpenAI-compatible endpoint works.
AI_LOCAL_BASE_URL="http://localhost:11434/v1"
AI_LOCAL_MODEL=""  # e.g. "llama3", "qwen2.5" — required when AI_PROVIDER=local

# Fallback behavior on provider failure:
#   "none" → user gets an honest error message (production default)
#   "mock" → development fallback to deterministic responses
AI_FALLBACK_PROVIDER="none"

# OpenAI (optional — only needed when AI_PROVIDER=openai)
AI_API_KEY=""
AI_API_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Shared AI config
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=15000
AI_RATE_LIMIT_PER_HOUR=20
AI_MAX_HISTORY=10

# ─── FIREBASE ───────────────────────────────────────────────────
# (Add your Firebase config here — see existing .env)

# ─── CLOUDINARY (Image Optimization) ────────────────────────────
# Cloudinary cloud name (found in your Cloudinary dashboard)
VITE_CLOUDINARY_CLOUD_NAME=""

# Unsigned upload preset (create in Cloudinary settings)
# Settings: Upload → Upload presets → Create new preset
# Mode: Unsigned, Folder: shop-nexa, Delivery type: upload
VITE_CLOUDINARY_UPLOAD_PRESET=""

# Optional: API key & secret (only for server-side signed uploads)
# Not needed if using unsigned upload presets (client-side upload)
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
